[*.yaml]
indent_style = space
trim_trailing_whitespace = true

[*.yml]
indent_style = space
trim_trailing_whitespace = true

[*.toml]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.json]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.lua]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# `nixfmt` uses fixed two-space indentation.
[*.nix]
indent_style = space
indent_size = 2
tab_width = 2
